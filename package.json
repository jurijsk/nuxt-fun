{
	"name": "nuxt-fun",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/jurijsk/nuxt-fun"
	},
	"scripts": {
		"build": "nuxt build",
		"lint": "eslint . --fix",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
