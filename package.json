		"@nuxtjs/i18n": "^10.2.3",
		"nuxt": "^4.3.1",
		"nuxt-studio": "^1.3.1",
		"vue": "^3.5.28",
		"vue-router": "^5.0.2"
	},
	"devDependencies": {
		"@nuxt/test-utils": "^4.0.0",
		"@playwright/test": "^1.58.2",
		"@vitest/coverage-v8": "^4.0.18",
		"@vue/test-utils": "^2.4.6",
		"happy-dom": "^20.6.3",
		"playwright-core": "^1.58.2",
		"vitest": "^4.0.18"
	}
